# Dokploy: devops-agent
# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate

ENV SERVICE_ID=devops-agent
ENV NODE_ENV=production
ENV NPM_CONFIG_PRODUCTION=false
ENV NODE_OPTIONS=--max-old-space-size=2048

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json shared/package.json
COPY packages/service-kit/package.json packages/service-kit/package.json
COPY services/devops-agent/package.json services/devops-agent/package.json

RUN --mount=type=cache,id=pnpm-devops,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm config set network-concurrency 4 \
  && pnpm config set fetch-retries 5 \
  && pnpm install --filter @factory/devops-agent... --frozen-lockfile

COPY . .

RUN chmod +x scripts/nixpacks-build.sh scripts/nixpacks-start.sh \
  && bash scripts/nixpacks-build.sh \
  && test -f services/devops-agent/dist/index.js

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git tini \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 aos \
  && useradd --system --uid 1001 --gid aos --create-home aos

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV SERVICE_ID=devops-agent

COPY --from=build --chown=aos:aos /app /app
RUN test -f /app/services/devops-agent/dist/index.js

USER aos
EXPOSE 4105
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "services/devops-agent/dist/index.js"]
