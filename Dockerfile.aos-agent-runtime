# Dokploy: aos-agent-runtime
#
# SERVICE_ID is baked at build-time — Dokploy Env is runtime-only, so Nixpacks
# fails with: Missing SERVICE_ID — set it in Dokploy Environment Settings.
#
# Dokploy settings:
#   Build Type:       Dockerfile  (نه Nixpacks)
#   Docker File:      Dockerfile.aos-agent-runtime
#   Root Directory:   /

# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate

ENV SERVICE_ID=aos-agent-runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NPM_CONFIG_PRODUCTION=false
ENV NODE_OPTIONS=--max-old-space-size=4096

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json shared/package.json
COPY packages/service-kit/package.json packages/service-kit/package.json
COPY services/aos-agent-runtime/package.json services/aos-agent-runtime/package.json

RUN --mount=type=cache,id=pnpm-agent-runtime,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm config set network-concurrency 4 \
  && pnpm config set fetch-retries 5 \
  && pnpm install --filter @factory/aos-agent-runtime... --frozen-lockfile

COPY . .

RUN echo "docker-build: SERVICE_ID=${SERVICE_ID}" \
  && chmod +x scripts/nixpacks-build.sh scripts/nixpacks-start.sh \
  && bash scripts/nixpacks-build.sh

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates tini \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate \
  && groupadd --system --gid 1001 aos \
  && useradd --system --uid 1001 --gid aos --create-home aos

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV SERVICE_ID=aos-agent-runtime

COPY --from=build --chown=aos:aos /app /app

USER aos

# Seven workers listen on their historical ports inside one process.
EXPOSE 4103 4106 4107 4109 4110 4114 4115
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "scripts/nixpacks-start.sh"]
