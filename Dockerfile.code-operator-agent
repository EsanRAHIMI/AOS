# Dokploy: code-operator-agent
# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate

ENV SERVICE_ID=code-operator-agent
ENV NODE_ENV=production
ENV NPM_CONFIG_PRODUCTION=false
ENV NODE_OPTIONS=--max-old-space-size=4096

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json shared/package.json
COPY packages/service-kit/package.json packages/service-kit/package.json
COPY services/code-operator-agent/package.json services/code-operator-agent/package.json

RUN --mount=type=cache,id=pnpm-code-operator,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm config set network-concurrency 4 \
  && pnpm config set fetch-retries 5 \
  && pnpm install --filter @factory/code-operator-agent... --frozen-lockfile

COPY . .

RUN chmod +x scripts/nixpacks-build.sh scripts/nixpacks-start.sh \
  && bash scripts/nixpacks-build.sh \
  && test -f services/code-operator-agent/dist/index.js

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git grep rsync tini \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate \
  && groupadd --system --gid 1001 aos \
  && useradd --system --uid 1001 --gid aos --create-home aos

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV SERVICE_ID=code-operator-agent

COPY --from=build --chown=aos:aos /app /app
RUN test -f /app/services/code-operator-agent/dist/index.js

USER aos
EXPOSE 4122
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "services/code-operator-agent/dist/index.js"]
